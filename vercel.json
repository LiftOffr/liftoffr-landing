{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt).*)",
      "has": [{ "type": "host", "value": "www.liftoffr.com" }],
      "destination": "https://liftoffr.com/$1",
      "permanent": true
    },
    {
      "source": "/ig",
      "destination": "/links/?utm_source=instagram&utm_medium=bio&utm_campaign=evergreen&utm_content=ig_bio",
      "permanent": true
    },
    {
      "source": "/yt",
      "destination": "/?utm_source=youtube&utm_medium=channel&utm_campaign=evergreen&utm_content=yt_channel",
      "permanent": true
    },
    {
      "source": "/tiktok",
      "destination": "/links/?utm_source=tiktok&utm_medium=bio&utm_campaign=evergreen&utm_content=tiktok_bio",
      "permanent": true
    },
    {
      "source": "/x",
      "destination": "/?utm_source=twitter&utm_medium=social&utm_campaign=evergreen&utm_content=x_thread",
      "permanent": true
    },
    {
      "source": "/checklist",
      "destination": "/?utm_source=shortlink&utm_medium=share&utm_campaign=evergreen&utm_content=checklist#free-checklist",
      "permanent": true
    },
    {
      "source": "/join",
      "destination": "https://whop.com/checkout/plan_CH1L53GLZsaq1?utm_source=shortlink&utm_medium=share&utm_campaign=evergreen&utm_content=join",
      "permanent": true
    },
    {
      "source": "/founder",
      "destination": "https://whop.com/checkout/plan_CH1L53GLZsaq1?utm_source=shortlink&utm_medium=share&utm_campaign=evergreen&utm_content=founder",
      "permanent": true
    },
    {
      "source": "/discord",
      "destination": "https://whop.com/liftoffr/?utm_source=shortlink&utm_medium=share&utm_campaign=evergreen&utm_content=discord",
      "permanent": true
    }
  ]
}
