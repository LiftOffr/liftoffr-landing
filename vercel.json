{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/founder-count",
      "destination": "/founder-count.json"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-weekly-score",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron-welcome-followups",
      "schedule": "0 17 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/ig",
      "destination": "/links?utm_source=instagram&utm_medium=bio&utm_campaign=links&utm_content=ig_bio",
      "permanent": false
    },
    {
      "source": "/yt",
      "destination": "/links?utm_source=youtube&utm_medium=bio&utm_campaign=links&utm_content=yt_bio",
      "permanent": false
    },
    {
      "source": "/tiktok",
      "destination": "/links?utm_source=tiktok&utm_medium=bio&utm_campaign=links&utm_content=tiktok_bio",
      "permanent": false
    },
    {
      "source": "/tt",
      "destination": "/links?utm_source=tiktok&utm_medium=bio&utm_campaign=links&utm_content=tt_bio",
      "permanent": false
    },
    {
      "source": "/x",
      "destination": "/links?utm_source=x&utm_medium=bio&utm_campaign=links&utm_content=x_bio",
      "permanent": false
    },
    {
      "source": "/clip",
      "destination": "/links?utm_source=clippers&utm_medium=social&utm_campaign=clipping&utm_content=clip",
      "permanent": false
    },
    {
      "source": "/legal",
      "destination": "/disclaimer",
      "permanent": false
    },
    {
      "source": "/checklist",
      "destination": "/quiz?utm_source=liftoffr&utm_medium=redirect&utm_campaign=quiz&utm_content=from_checklist",
      "permanent": false
    },
    {
      "source": "/buyzone",
      "destination": "/quiz?utm_source=liftoffr&utm_medium=redirect&utm_campaign=quiz&utm_content=from_buyzone",
      "permanent": false
    },
    {
      "source": "/start",
      "destination": "/plan?utm_source=shortlink&utm_medium=cta&utm_campaign=plan&utm_content=start",
      "permanent": false
    },
    {
      "source": "/join",
      "destination": "/plan?utm_source=shortlink&utm_medium=share&utm_campaign=plan&utm_content=join",
      "permanent": false
    },
    {
      "source": "/founder",
      "destination": "/plan?utm_source=shortlink&utm_medium=share&utm_campaign=plan&utm_content=founder",
      "permanent": false
    },
    {
      "source": "/discord",
      "destination": "https://whop.com/liftoffr/?utm_source=shortlink&utm_medium=share&utm_campaign=evergreen&utm_content=discord",
      "permanent": true
    },
    {
      "source": "/r/:id",
      "destination": "/score?utm_source=instagram&utm_medium=reel&utm_campaign=phase_b&utm_content=:id",
      "permanent": false
    },
    {
      "source": "/p/:id",
      "destination": "/plan?utm_source=instagram&utm_medium=reel&utm_campaign=phase_b&utm_content=:id",
      "permanent": false
    },
    {
      "source": "/w/:id",
      "destination": "/receipts?utm_source=instagram&utm_medium=reel&utm_campaign=phase_b&utm_content=:id",
      "permanent": false
    },
    {
      "source": "/aug/:id",
      "destination": "/score?utm_source=instagram&utm_medium=reel&utm_campaign=remote_aug&utm_content=:id",
      "permanent": false
    },
    {
      "source": "/log/:id",
      "destination": "/receipts?utm_source=instagram&utm_medium=reel&utm_campaign=remote_aug&utm_content=:id",
      "permanent": false
    }
  ]
}
